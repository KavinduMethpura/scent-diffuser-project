# ==============================================================================
# Scent Diffuser Web App — Environment Variables Template
# Copy this file to .env or .env.local and fill in your values.
# DO NOT commit your actual .env file with secrets to Git.
# ==============================================================================

# 1. Google Health / Fitbit OAuth 2.0 Credentials (from Google Cloud Console)
FITBIT_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
FITBIT_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# 2. OAuth Redirect Callback URL
# Local development: http://localhost:3000/api/auth/callback
# Vercel production: https://your-project.vercel.app/api/auth/callback
FITBIT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 3. Device Shared Secret (Shared between this web app and ESP32 config.h)
DEVICE_SHARED_KEY=generate_a_long_random_secret_token_here

# 4. Storage Configuration
# - For local testing: LEAVE THESE BLANK / COMMENTED. The app automatically
#   uses a local file (.local_kv_store.json) for storage with zero database setup.
# - For Vercel production: Vercel automatically injects these when you link KV storage.
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
